{
  "version": "1.2.0",
  "id": "@shopgate-project/search-batteryincluded",
  "components": [
  ],
  "steps": [
    {
      "path": "extension/steps/routeCategoryToBi.js",
      "description": "Routes category listings to the BatteryIncluded search pipelines",
      "hooks": ["shopgate.catalog.getProducts.v1:before"],
      "input": [
        { "key": "categoryId", "optional": true },
        { "key": "searchPhrase", "optional": true },
        { "key": "filters", "optional": true },
        { "key": "productIds", "optional": true },
        { "key": "offset", "optional": true }
      ],
      "output": [
        { "key": "categoryId", "optional": true },
        { "key": "searchPhrase", "optional": true },
        { "key": "filters", "optional": true }
      ]
    }
  ],
  "configuration": {
    "baseUrl": {
      "type": "admin",
      "destination": "backend",
      "default": "https://api.batteryincluded.io",
      "params": {
        "label": "BatteryIncluded API endpoint",
        "type": "text"
      }
    },
    "collection": {
      "type": "admin",
      "destination": "backend",
      "default": "",
      "params": {
        "label": "Collection name (from BatteryIncluded)",
        "type": "text"
      }
    },
    "publicApiKey": {
      "type": "admin",
      "destination": "backend",
      "default": "",
      "params": {
        "label": "Public API key (BatteryIncluded)",
        "type": "text"
      }
    },
    "productIdentifier": {
      "type": "admin",
      "destination": "backend",
      "default": "_product.id",
      "params": {
        "label": "Product ID field (dot-notation)",
        "type": "text"
      }
    },
    "locale": {
      "type": "admin",
      "destination": "backend",
      "default": "",
      "params": {
        "label": "Locale (e.g. de, de-DE)",
        "type": "text"
      }
    },
    "filterFacets": {
      "type": "admin",
      "destination": "backend",
      "default": [],
      "params": {
        "label": "Filter facets (fields & labels)",
        "type": "json"
      }
    },
    "catalogService": {
      "type": "admin",
      "destination": "backend",
      "default": "CATALOG_SERVICE_PRODUCTS",
      "params": {
        "type": "select",
        "label": "Catalog Service",
        "required": true,
        "options": {
          "multiple": false,
          "options": [
            { "label": "Products Service", "value": "CATALOG_SERVICE_PRODUCTS" },
            { "label": "Generic Catalog Service",  "value": "CATALOG_SERVICE_GENERIC" }
          ]
        }
      }
    },
    "categoryListingEnabled": {
      "type": "admin",
      "destination": "backend",
      "default": false,
      "params": {
        "type": "checkbox",
        "label": "Use BatteryIncluded for category product listings"
      }
    },
    "categoryFilterField": {
      "type": "admin",
      "destination": "backend",
      "default": "name",
      "params": {
        "type": "select",
        "label": "Category filter field (BatteryIncluded)",
        "required": true,
        "options": {
          "multiple": false,
          "options": [
            {
              "label": "Category path (merchandising rules apply)",
              "value": "name"
            },
            {
              "label": "Category id (no merchandising rules)",
              "value": "id"
            }
          ]
        }
      }
    }
  }
}
